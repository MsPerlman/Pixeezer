    <string name="word_delimiter_section_title">Délimiteurs de mots actuels</string>
    <string name="word_delimiter_section_subtitle">Ces mots-clés séparent les noms d\'artistes lorsqu\'ils sont entourés d\'espaces. Recherche sans distinction de casse. Appuie pour retirer.</string>
